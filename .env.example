# Configuracion de Cotizaciones (docs/plans/00-contratos-y-datos.md, seccion 11).
# Valores para el entorno Docker de docker-compose.yaml: los hosts "postgres" y
# "pulsar" solo existen dentro de la red de Compose (contenedor dev). Sin secretos.

COTIZACIONES_SERVICE_NAME=cotizaciones
# Vacio: la app arranca sin base ni procesamiento. Con la base del Compose:
# postgresql+psycopg://cotizaciones:cotizaciones_local@postgres:5432/cotizaciones
COTIZACIONES_DATABASE_URL=
COTIZACIONES_DB_POOL_SIZE=5
COTIZACIONES_DB_MAX_OVERFLOW=5
COTIZACIONES_DB_STATEMENT_TIMEOUT_MS=3000

COTIZACIONES_PULSAR_URL=pulsar://pulsar:6650
# Solo scripts de preparacion y metricas.
COTIZACIONES_PULSAR_ADMIN_URL=http://pulsar:8080
COTIZACIONES_TOPICO_PETICIONES=persistent://public/default/solicitar-cotizacion-v1
COTIZACIONES_SUSCRIPCION_PETICIONES=cotizaciones-peticiones-v1
COTIZACIONES_TOPICO_REGISTRADA=persistent://public/default/cotizacion-registrada-v1
COTIZACIONES_TOPICO_RECHAZADA=persistent://public/default/cotizacion-rechazada-v1
COTIZACIONES_PULSAR_TIMEOUT_SEGUNDOS=3
COTIZACIONES_PULSAR_RECEPTOR_COLA=1
COTIZACIONES_PULSAR_DEMORA_NACK_MS=5000
# Solo calibracion E4; si es > 0 los resultados se rotulan como sinteticos.
COTIZACIONES_RETARDO_LABORATORIO_MS=0

# Solo Compose local (puertos publicados en 127.0.0.1 del host).
COTIZACIONES_POSTGRES_PORT=55436
COTIZACIONES_PULSAR_ADMIN_PORT=18096

# Pruebas de integracion (el contenedor dev ya las define).
COTIZACIONES_TEST_DATABASE_URL=postgresql+psycopg://cotizaciones:cotizaciones_local@postgres:5432/cotizaciones
COTIZACIONES_TEST_PULSAR_URL=pulsar://pulsar:6650
COTIZACIONES_TEST_PULSAR_ADMIN_URL=http://pulsar:8080

# Puerto HTTP (Cloud Run lo inyecta).
PORT=8002
